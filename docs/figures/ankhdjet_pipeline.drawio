  <diagram name="Ankhdjet" id="ankhdjet">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title (centered in inner content width 1740) -->
        <mxCell id="title" value="Ankhdjet compiler &amp; RTL pipeline"
                style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1740" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="ternary model → ternary IR → SystemVerilog → Verilator-verified, bit-exact match to Python reference"
                style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#555555;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="56" width="1740" height="22" as="geometry"/>
        </mxCell>

        <!-- ================================================================
             ROW 1 — primary horizontal flow.
               60 (margin)  240 (train)  60  220 (IR)  80  380 (compile)
               80  320 (generated)  60  300 (verify)  60 (margin) = 1860
             80-px gaps before/after `compile` give room for "emits .sv"
             and the IR→compile arrow without label crowding.
             ================================================================ -->
        <mxCell id="g_train" value="1. Ternary model"
                style="swimlane;startSize=28;fillColor=#E1D5E7;strokeColor=#9673A6;html=1;fontSize=12;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="240" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="b_bitlinear" value="ternary model&#10;W ∈ {-1,0,+1} + per-tensor scales"
                style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontSize=11;"
                vertex="1" parent="g_train">
          <mxGeometry x="20" y="40" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="b_commit" value="importer: frontend/hf.py&#10;(ternary checkpoint loader: BitNet b1.58 + kin)"
