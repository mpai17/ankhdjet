<mxfile host="app.diagrams.net">
  <diagram id="bitcell-vs-tr" name="bitcell_vs_transistor">
    <mxGraphModel dx="1200" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="One transistor, two jobs: general-purpose logic device vs mask-programmed ternary ROM cell"
                style="text;html=1;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1020" height="30" as="geometry"/>
        </mxCell>

        <!-- ================= LEFT PANEL: logic NMOS ================= -->
        <mxCell id="lp" value="" style="rounded=0;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="480" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="lp_t" value="Standard logic NMOS" style="text;html=1;align=center;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="480" height="22" as="geometry"/>
        </mxCell>

        <!-- three any-net stubs -->
        <mxCell id="l_s_wire" value="" style="rounded=0;fillColor=#666666;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="182" y="150" width="6" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="l_g_wire" value="" style="rounded=0;fillColor=#D79B00;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="277" y="150" width="6" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="l_d_wire" value="" style="rounded=0;fillColor=#666666;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="372" y="150" width="6" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="l_s_lab" value="To: any net&#10;(P&amp;R decides)" style="text;html=1;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="130" y="108" width="110" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="l_g_lab" value="To: any net&#10;(P&amp;R decides)" style="text;html=1;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="225" y="108" width="110" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="l_d_lab" value="To: any net&#10;(P&amp;R decides)" style="text;html=1;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="108" width="110" height="36" as="geometry"/>
